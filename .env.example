# ASSEY Atelier — Environment Variables
# Copy this file to .env and fill in real values before running locally or deploying.

# ---- Django Core --------------------------------------------------
SECRET_KEY=replace-with-a-long-random-string-at-least-50-chars
DEBUG=0
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# ---- Database (leave blank to use SQLite for local dev) -----------
# Postgres (Railway / Render / Supabase):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# MySQL (PlanetScale / Cloud SQL):
# DATABASE_URL=mysql://user:password@host:3306/dbname

# ---- CORS ---------------------------------------------------------
# Comma-separated list of allowed frontend origins (required in production)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ---- Logging ------------------------------------------------------
DJANGO_LOG_LEVEL=WARNING
