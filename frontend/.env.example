# Database (SQLite for local dev, LibSQL/Turso for production)
DATABASE_URL="file:./dev.db"

# Supabase (for auth + storage — REQUIRED)
# Get these from your Supabase project at https://app.supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Site URL (set to your production domain in Vercel dashboard)
# On Vercel, you can also use: NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Django backend API base URL (if using Django as headless API)
# Set to empty or omit to use local Prisma queries instead
NEXT_PUBLIC_API_BASE=http://localhost:8000/api
